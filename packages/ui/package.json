{
  "name": "@discuss-ds/ui",
  "version": "0.12.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/globals.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "lint": "oxlint src",
    "test": "vitest run",
    "prepack": "tsup"
  },
  "dependencies": {
    "@discuss-ds/tokens": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.1.1",
    "react-day-picker": "^10.0.2",
    "react-hook-form": "^7.88.0",
    "tailwind-merge": "^2.6.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.1.0",
    "tsup": "^8.3.5",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "description": "Discuss design system React component library",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TamyresLucas/Discuss-UI-Storybook.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "src/styles",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./styles.css": "./src/styles/globals.css",
      "./package.json": "./package.json"
    }
  }
}
