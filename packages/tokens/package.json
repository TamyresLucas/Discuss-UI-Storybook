{
  "name": "@discuss-ds/tokens",
  "version": "0.2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./css": "./src/tokens.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "lint": "oxlint src",
    "prepack": "tsup"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "~6.0.2"
  },
  "description": "Design tokens (CSS custom properties) for the Discuss design system",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TamyresLucas/Discuss-UI-Storybook.git",
    "directory": "packages/tokens"
  },
  "files": [
    "dist",
    "src/tokens.css",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./css": "./src/tokens.css",
      "./package.json": "./package.json"
    }
  }
}
