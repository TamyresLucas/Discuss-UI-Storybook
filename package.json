{
  "name": "discuss-design-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "storybook": "turbo run storybook --filter=@discuss-ds/storybook",
    "build-storybook": "turbo run build --filter=@discuss-ds/storybook",
    "playground": "turbo run dev --filter=@discuss-ds/playground",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=@discuss-ds/tokens --filter=@discuss-ds/ui && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "oxlint": "^1.81.0",
    "turbo": "^2.3.3",
    "typescript": "~6.0.2"
  }
}
